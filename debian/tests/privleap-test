## Runs the privleap regression suite under coverage.py and reports how much of
## the privleap Python code it reaches.

set -o errexit
set -o nounset
set -o pipefail
set -o errtrace
shopt -s inherit_errexit
shopt -s shift_verbose
export LC_ALL=C

repo_dir="$(pwd)"
rcfile="${repo_dir}/debian/tests/coverage/coveragerc"

## AUTOPKGTEST_ARTIFACTS might be a relative path.
artifacts_dir="$(realpath -- "${AUTOPKGTEST_ARTIFACTS:-${repo_dir}/autopkgtest-artifacts}")"

## cov_dir holds the raw coverage DATA and must be world-writable, as the
## unprivileged clients run by the test suite write their own data files here.
## Sticky bit so a client cannot rename or replace another account's (or root's)
## data files. It must hold DATA only -- never anything root later imports; see
## the bootstrap dir below.
cov_dir="${artifacts_dir}/privleap-coverage"
mkdir --parents -- "${cov_dir}"
chmod 1777 -- "${cov_dir}"

## The suite runs leaprun as unprivileged accounts (via 'sudo -u'), and their
## coverage must be measured too. That needs three things to reach those
## processes; without all three the client coverage is silently dropped and the
## reported total is misleadingly low.

## (1) The coverage bootstrap (sitecustomize.py + coveragerc) must be READABLE
## by the client accounts. autopkgtest's unshare backend copies the source tree
## as mode 0770 owned by an unprivileged 'unshare' user, so the client accounts
## cannot read it there. site.py imports sitecustomize inside a silenced
## try/except, so the failure is invisible and coverage.process_startup() never
## runs for the clients. Stage the bootstrap in a world-READABLE dir instead.
## It must NOT be world-writable and must NOT live under the world-writable
## cov_dir: root's later 'coverage combine' auto-imports sitecustomize.py from
## here via PYTHONPATH, so a world-writable bootstrap would let any local
## account replace it and execute code as root. Keep it root-owned, mode 0755.
cov_bootstrap_dir="${artifacts_dir}/privleap-coverage-bootstrap"
mkdir --parents -- "${cov_bootstrap_dir}"
chmod 0755 -- "${cov_bootstrap_dir}"
cp -- "${repo_dir}/debian/tests/coverage/sitecustomize.py" \
  "${cov_bootstrap_dir}/sitecustomize.py"
cp -- "${rcfile}" "${cov_bootstrap_dir}/coveragerc"
chmod 644 -- "${cov_bootstrap_dir}/sitecustomize.py" \
  "${cov_bootstrap_dir}/coveragerc"
rcfile="${cov_bootstrap_dir}/coveragerc"

## (2) The three coverage variables must survive 'sudo -u'. sudo resets the
## environment and strips PYTHONPATH by default, so an env_keep rule is
## required. Scope it to 'Defaults:root': the suite always invokes the client
## sudo AS root, so root is the only invoking user that needs the variables
## preserved. An unscoped 'Defaults env_keep' would apply to every sudo caller,
## letting any sudo-capable account smuggle PYTHONPATH / COVERAGE_PROCESS_START
## (code execution as root via sitecustomize or a coverage plugin) or
## COVERAGE_FILE (arbitrary root file overwrite) into a root sudo command.
## Validate before installing, and remove on exit so the rule never outlives the
## run on a persistent or 'null' testbed.
coverage_sudoers=/etc/sudoers.d/privleap-coverage
coverage_sudoers_tmp="$(mktemp)"
trap 'rm -f -- "${coverage_sudoers}" "${coverage_sudoers_tmp}"' EXIT
printf '%s\n' \
  'Defaults:root env_keep += "COVERAGE_PROCESS_START"' \
  'Defaults:root env_keep += "COVERAGE_FILE"' \
  'Defaults:root env_keep += "PYTHONPATH"' \
  > "${coverage_sudoers_tmp}"
visudo -cf "${coverage_sudoers_tmp}" >/dev/null
install -m 0440 -o root -g root -- \
  "${coverage_sudoers_tmp}" "${coverage_sudoers}"

## (3) cov_dir is world-writable (above), so the clients can write their data.

export COVERAGE_PROCESS_START="${rcfile}"
export COVERAGE_FILE="${cov_dir}/.coverage"
export PYTHONPATH="${cov_bootstrap_dir}${PYTHONPATH:+:${PYTHONPATH}}"

test_rc=0
./test/run-test || test_rc="$?"

## Regression guard: the unprivileged clients must have written their own
## coverage data (files owned by a non-root user). If none did, client coverage
## capture has broken again and the report would silently exclude the clients --
## fail loudly rather than publish a misleading total.
client_cov_count="$(find "${cov_dir}" -maxdepth 1 -name '.coverage.*' \
  ! -user root -printf '.' | wc -c)"
if [ "${client_cov_count}" -eq 0 ]; then
  printf '%s\n' \
    'ERROR: no coverage data from unprivileged clients was captured.' \
    'Client coverage (leaprun run via sudo) is being lost; refusing to' \
    'report a misleading coverage total.' 1>&2
  exit 1
fi
printf 'Captured coverage from %s unprivileged client process(es).\n' \
  "${client_cov_count}" 1>&2

## Root writes the combined database and the xml/html reports; send them to a
## root-owned dir, never the world-writable cov_dir, or a local account could
## plant a symlink (e.g. .coverage -> /etc/shadow) that root's combine/xml would
## follow and overwrite. cov_dir holds only the clients' own data files, which
## combine reads.
cov_out_dir="${artifacts_dir}/privleap-coverage-report"
mkdir --parents -- "${cov_out_dir}"
chmod 0755 -- "${cov_out_dir}"
combined_file="${cov_out_dir}/.coverage"
COVERAGE_FILE="${combined_file}" \
  python3 -m coverage combine --rcfile="${rcfile}" "${cov_dir}"
COVERAGE_FILE="${combined_file}" \
  python3 -m coverage report --rcfile="${rcfile}" 1>&2
COVERAGE_FILE="${combined_file}" \
  python3 -m coverage xml --rcfile="${rcfile}" -o "${cov_out_dir}/coverage.xml"
COVERAGE_FILE="${combined_file}" \
  python3 -m coverage html --rcfile="${rcfile}" \
  --directory="${cov_out_dir}/coverage_html"

exit "${test_rc}"
